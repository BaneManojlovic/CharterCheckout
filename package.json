{
  "name": "chartercheckout-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Appium + Cucumber.js (Gherkin BDD) end-to-end test automation for CharterCheckoutApp (iOS native, SwiftUI)",
  "scripts": {
    "appium": "appium",
    "test": "cucumber-js --config cucumber.js",
    "test:tag": "cucumber-js --config cucumber.js --tags",
    "test:checkout-success": "cucumber-js --config cucumber.js --tags @checkout-success",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@types/node": "^22.0.0",
    "appium": "^2.11.0",
    "appium-xcuitest-driver": "^9.10.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "webdriverio": "^9.4.0"
  }
}
